<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom border-light">
    <h1 class="h2 fw-bold text-dark">Log Aktivitas Petugas</h1>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4">
        <h5 class="card-title fw-bold text-dark mb-0"><i class="bi bi-clock-history text-primary me-2"></i> Riwayat Audit</h5>
    </div>
    <div class="card-body px-0 pt-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="border-0 ps-4 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Waktu</th>
                        <th class="border-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">User</th>
                        <th class="border-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Aksi</th>
                        <th class="border-0 fw-medium text-uppercase small d-none d-lg-table-cell" style="letter-spacing: 0.5px;">ID Warga</th>
                        <th class="border-0 fw-medium text-uppercase small d-none d-md-table-cell" style="letter-spacing: 0.5px;">Nama Warga</th>
                        <th class="border-0 pe-4 fw-medium text-uppercase small text-end" style="letter-spacing: 0.5px;">Detail</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    <% logs.forEach(log => { %>
                        <tr>
                            <td class="ps-4 py-3 text-secondary small">
                                <div class="d-none d-sm-block"><i class="bi bi-calendar3 me-1 opacity-75"></i> <%= new Date(log.created_at).toLocaleString() %></div>
                                <div class="d-sm-none"><%= new Date(log.created_at).toLocaleDateString() %><br><%= new Date(log.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></div>
                            </td>
                            <td class="py-3">
                                <div class="fw-semibold text-dark"><%= log.user ? log.user.nama_lengkap : 'Unknown' %></div>
                                <div class="small text-muted d-none d-sm-block"><%= log.user ? log.user.role : '-' %></div>
                            </td>
                            <td class="py-3">
                                <% if (log.action === 'CREATE') { %>
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 px-md-3 py-1"><i class="bi bi-plus-circle me-1"></i><span class="d-none d-md-inline">CREATE</span></span>
                                <% } else if (log.action === 'UPDATE') { %>
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-2 px-md-3 py-1"><i class="bi bi-pencil-square me-1"></i><span class="d-none d-md-inline">UPDATE</span></span>
                                <% } else if (log.action === 'DELETE') { %>
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2 px-md-3 py-1"><i class="bi bi-trash me-1"></i><span class="d-none d-md-inline">DELETE</span></span>
                                <% } else if (log.action === 'SYNC_SCHEMA') { %>
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-2 px-md-3 py-1"><i class="bi bi-database-fill-gear me-1"></i><span class="d-none d-md-inline">SYNC</span></span>
                                <% } %>
                            </td>
                            <td class="py-3 text-secondary d-none d-lg-table-cell">
                                <span class="badge bg-light text-dark border px-2 py-1 rounded-pill font-monospace"><%= log.warga_id || '-' %></span>
                            </td>
                            <td class="py-3 fw-medium text-dark d-none d-md-table-cell"><%= log.warga_name || '-' %></td>
                            <td class="pe-4 py-3 text-end">
                                <a href="/admin/audit/view/<%= log.id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
                                    <i class="bi bi-eye"></i> <span class="d-none d-md-inline">Lihat</span>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (logs.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                Belum ada riwayat aktivitas.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <% if (totalPages > 1) { %>
        <div class="card-footer bg-white border-top-0 pb-4 px-4">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link rounded-pill px-3 me-2" href="?page=<%= currentPage - 1 %>&limit=<%= limit %>" aria-label="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                            <a class="page-link rounded-circle mx-1" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;" href="?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
                        </li>
                    <% } %>
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                        <a class="page-link rounded-pill px-3 ms-2" href="?page=<%= currentPage + 1 %>&limit=<%= limit %>" aria-label="Next">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="text-center text-muted small mt-3">
                Menampilkan <%= logs.length %> dari <%= totalItems %> riwayat aktivitas
            </div>
        </div>
    <% } %>
</div>
