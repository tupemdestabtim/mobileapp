<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom border-light">
    <h1 class="h2 fw-bold text-dark">Detail Log Aktivitas</h1>
    <a href="/admin/audit" class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm fw-medium"><i class="bi bi-arrow-left me-1"></i> Kembali</a>
</div>

<div class="row g-4">
    <div class="col-md-4 mb-4">
        <div class="card shadow-sm h-100 border-0 rounded-4">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                <h5 class="card-title fw-bold text-dark mb-0"><i class="bi bi-info-circle-fill text-primary me-2"></i> Informasi Aksi</h5>
            </div>
            <div class="card-body p-4">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 py-3 border-light">
                        <span class="text-secondary small d-block mb-1">Waktu</span>
                        <span class="fw-semibold text-dark"><i class="bi bi-calendar3 me-2 text-primary opacity-75"></i><%= new Date(log.created_at).toLocaleString() %></span>
                    </li>
                    <li class="list-group-item px-0 py-3 border-light">
                        <span class="text-secondary small d-block mb-1">Aktor</span>
                        <span class="fw-semibold text-dark"><i class="bi bi-person-badge me-2 text-primary opacity-75"></i><%= log.user ? log.user.nama_lengkap : 'Unknown' %> <span class="badge bg-light text-dark border ms-1"><%= log.user ? log.user.role : '-' %></span></span>
                    </li>
                    <li class="list-group-item px-0 py-3 border-light">
                        <span class="text-secondary small d-block mb-2">Jenis Aksi</span>
                        <% if (log.action === 'CREATE') { %>
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-plus-circle me-1"></i>CREATE</span>
                        <% } else if (log.action === 'UPDATE') { %>
                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-pencil-square me-1"></i>UPDATE</span>
                        <% } else if (log.action === 'DELETE') { %>
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-trash me-1"></i>DELETE</span>
                        <% } else if (log.action === 'SYNC_SCHEMA') { %>
                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill px-3 py-1"><i class="bi bi-database-fill-gear me-1"></i>SYNC SCHEMA</span>
                        <% } %>
                    </li>
                    <li class="list-group-item px-0 py-3 border-light">
                        <span class="text-secondary small d-block mb-1">Target Warga ID</span>
                        <span class="fw-medium text-dark"><%= log.warga_id || '-' %></span>
                    </li>
                    <li class="list-group-item px-0 pt-3 pb-0 border-0">
                        <span class="text-secondary small d-block mb-1">Nama Warga</span>
                        <span class="fw-bold text-primary"><%= log.warga_name || '-' %></span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-8 mb-4">
        <div class="card shadow-sm h-100 border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-primary text-white border-bottom-0 pt-4 pb-3 px-4 d-flex align-items-center">
                <i class="bi bi-file-earmark-code fs-5 me-2"></i>
                <h5 class="card-title fw-bold mb-0">Detail Perubahan Data</h5>
            </div>
            <div class="card-body bg-light p-4" style="max-height: 500px; overflow-y: auto;">
                <% if (log.action === 'CREATE') { %>
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-file-plus text-success fs-4 me-2"></i>
                        <h6 class="fw-bold text-success mb-0">Data Baru (Insert)</h6>
                    </div>
                    <pre class="bg-white p-4 border-0 shadow-sm rounded-3 text-secondary" style="font-size: 0.9rem;"><code><%= JSON.stringify(JSON.parse(log.new_data || '{}'), null, 2) %></code></pre>
                <% } else if (log.action === 'DELETE') { %>
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-file-minus text-danger fs-4 me-2"></i>
                        <h6 class="fw-bold text-danger mb-0">Data Dihapus</h6>
                    </div>
                    <pre class="bg-white p-4 border-0 shadow-sm rounded-3 text-secondary" style="font-size: 0.9rem;"><code><%= JSON.stringify(JSON.parse(log.old_data || '{}'), null, 2) %></code></pre>
                <% } else if (log.action === 'UPDATE') { %>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3 pb-2 border-bottom border-danger border-opacity-25">
                                <i class="bi bi-clock-history text-danger fs-5 me-2"></i>
                                <h6 class="fw-bold text-danger mb-0">Data Lama</h6>
                            </div>
                            <pre class="bg-white p-4 border-0 shadow-sm rounded-3 text-secondary" style="font-size: 0.85rem;"><code><%= JSON.stringify(JSON.parse(log.old_data || '{}'), null, 2) %></code></pre>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3 pb-2 border-bottom border-success border-opacity-25">
                                <i class="bi bi-stars text-success fs-5 me-2"></i>
                                <h6 class="fw-bold text-success mb-0">Data Baru</h6>
                            </div>
                            <pre class="bg-white p-4 border-0 shadow-sm rounded-3 text-secondary" style="font-size: 0.85rem;"><code><%= JSON.stringify(JSON.parse(log.new_data || '{}'), null, 2) %></code></pre>
                        </div>
                    </div>
                <% } else if (log.action === 'SYNC_SCHEMA') { %>
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-database-check text-info fs-4 me-2"></i>
                        <h6 class="fw-bold text-info mb-0">Detail Sinkronisasi</h6>
                    </div>
                    <pre class="bg-white p-4 border-0 shadow-sm rounded-3 text-secondary" style="font-size: 0.9rem;"><code><%= JSON.stringify(JSON.parse(log.new_data || '{}'), null, 2) %></code></pre>
                <% } %>
            </div>
        </div>
    </div>
</div>
