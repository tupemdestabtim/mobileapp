<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom border-light">
    <h1 class="h2 fw-bold text-dark">Data Warga</h1>
</div>





<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h5 class="card-title fw-bold text-dark mb-0"><i class="bi bi-people-fill text-primary me-2"></i> Daftar Warga Terdaftar</h5>
            <div class="d-flex flex-wrap gap-2">
                <form action="/admin/warga" method="GET" class="input-group input-group-sm" style="width: 250px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Cari NIK atau Nama..." value="<%= search %>">
                </form>
                <button id="bulkDeleteBtn" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-medium d-none" onclick="confirmBulkDelete()">
                    <i class="bi bi-trash3-fill me-1"></i> Hapus Terpilih (<span id="selectedCount">0</span>)
                </button>
                <a href="/admin/warga/add" class="btn btn-primary btn-sm rounded-pill shadow-sm px-4 fw-medium">
                    <i class="bi bi-person-plus-fill me-1"></i> Tambah Warga
                </a>
            </div>
        </div>
    </div>
    <div class="card-body px-0 pt-0">
        <form id="bulkDeleteForm" action="/admin/warga/bulk-delete" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="wargaTable">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="border-0 ps-4 py-3" style="width: 40px;">
                                <div class="form-check">
                                    <input class="form-check-input border-secondary" type="checkbox" id="selectAll">
                                </div>
                            </th>
                            <th class="border-0 fw-medium text-uppercase small d-none d-lg-table-cell" style="letter-spacing: 0.5px;">NIK</th>
                            <th class="border-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Nama Lengkap</th>
                            <th class="border-0 fw-medium text-uppercase small d-none d-md-table-cell" style="letter-spacing: 0.5px;">Dusun</th>
                            <th class="border-0 fw-medium text-uppercase small d-none d-xl-table-cell" style="letter-spacing: 0.5px;">Petugas Input</th>
                            <th class="border-0 fw-medium text-uppercase small d-none d-sm-table-cell" style="letter-spacing: 0.5px;">Tanggal Input</th>
                            <th class="border-0 pe-4 fw-medium text-uppercase small text-end" style="letter-spacing: 0.5px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        <% warga.forEach(w => { %>
                            <tr class="warga-row">
                                <td class="ps-4 py-3">
                                    <div class="form-check">
                                        <input class="form-check-input border-secondary row-checkbox" type="checkbox" name="ids[]" value="<%= w.id %>">
                                    </div>
                                </td>
                                <td class="py-3 d-none d-lg-table-cell"><span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 rounded-pill font-monospace"><%= w.nik %></span></td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle d-none d-sm-flex align-items-center justify-content-center me-3" style="width: 36px; height: 36px; font-weight: bold;">
                                            <%= w.nama_lengkap.charAt(0).toUpperCase() %>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark"><%= w.nama_lengkap %></div>
                                            <div class="d-lg-none small text-muted font-monospace"><%= w.nik %></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 text-secondary d-none d-md-table-cell">
                                    <% if (w.Dusun) { %>
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1 rounded-pill"><i class="bi bi-geo-alt-fill me-1"></i><%= w.Dusun.nama_dusun %></span>
                                    <% } else { %>
                                        <span class="text-muted fst-italic">-</span>
                                    <% } %>
                                </td>
                                <td class="py-3 text-secondary small d-none d-xl-table-cell">
                                    <i class="bi bi-person-badge me-1 text-primary opacity-50"></i> <%= w.creator ? w.creator.nama_lengkap : 'Admin' %>
                                </td>
                                <td class="py-3 text-secondary small d-none d-sm-table-cell">
                                    <i class="bi bi-calendar-check me-1 text-success opacity-50"></i> <%= new Date(w.created_at).toLocaleDateString() %>
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    <div class="btn-group shadow-sm rounded-pill" role="group">
                                        <a href="/admin/warga/view/<%= w.id %>" class="btn btn-light btn-sm text-primary border border-end-0 px-2 px-md-3" title="Detail"><i class="bi bi-eye"></i></a>
                                        <a href="/admin/warga/edit/<%= w.id %>" class="btn btn-light btn-sm text-warning border border-end-0 px-2 px-md-3" title="Edit"><i class="bi bi-pencil-square"></i></a>
                                        <button type="button" class="btn btn-light btn-sm text-danger border px-2 px-md-3 rounded-start-0" title="Hapus" onclick="confirmDelete('<%= w.id %>')"><i class="bi bi-trash3"></i></button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                        <% if (warga.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                    Belum ada data warga terdaftar.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </form>
    </div>
    <% if (totalPages > 1) { %>
        <div class="card-footer bg-white border-top-0 pb-4 px-4">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link rounded-pill px-3 me-2" href="?page=<%= currentPage - 1 %>&search=<%= search %>&limit=<%= limit %>" aria-label="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                            <a class="page-link rounded-circle mx-1" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;" href="?page=<%= i %>&search=<%= search %>&limit=<%= limit %>"><%= i %></a>
                        </li>
                    <% } %>
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                        <a class="page-link rounded-pill px-3 ms-2" href="?page=<%= currentPage + 1 %>&search=<%= search %>&limit=<%= limit %>" aria-label="Next">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="text-center text-muted small mt-3">
                Menampilkan <%= warga.length %> dari <%= totalItems %> data warga
            </div>
        </div>
    <% } %>
</div>

<!-- Hidden Individual Delete Form -->
<form id="deleteForm" method="POST" style="display: none;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const selectAll = document.getElementById('selectAll');
        const rowCheckboxes = document.querySelectorAll('.row-checkbox');
        const bulkDeleteBtn = document.getElementById('bulkDeleteBtn');
        const selectedCountSpan = document.getElementById('selectedCount');

        // Selection Logic
        if (selectAll) {
            selectAll.addEventListener('change', function() {
                rowCheckboxes.forEach(cb => {
                    cb.checked = this.checked;
                });
                updateBulkDeleteUI();
            });
        }

        rowCheckboxes.forEach(cb => {
            cb.addEventListener('change', updateBulkDeleteUI);
        });

        function updateBulkDeleteUI() {
            const checkedCount = Array.from(rowCheckboxes).filter(cb => cb.checked).length;
            selectedCountSpan.innerText = checkedCount;
            if (checkedCount > 0) {
                bulkDeleteBtn.classList.remove('d-none');
            } else {
                bulkDeleteBtn.classList.add('d-none');
            }
        }
    });

    function confirmDelete(id) {
        Swal.fire({
            title: 'Hapus Data Warga?',
            text: "Seluruh data kependudukan warga ini akan dihapus permanen.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Ya, Hapus!',
            cancelButtonText: 'Batal',
            customClass: {
                popup: 'rounded-4 shadow-lg border-0',
                confirmButton: 'btn btn-danger rounded-pill px-4',
                cancelButton: 'btn btn-light rounded-pill px-4 ms-2'
            },
            buttonsStyling: false
        }).then((result) => {
            if (result.isConfirmed) {
                const form = document.getElementById('deleteForm');
                form.action = `/admin/warga/delete/${id}`;
                form.submit();
            }
        })
    }

    function confirmBulkDelete() {
        const checkedCount = document.getElementById('selectedCount').innerText;
        Swal.fire({
            title: `Hapus ${checkedCount} Data?`,
            text: "Data warga yang dipilih akan dihapus secara massal dan permanen.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Ya, Hapus Semua!',
            cancelButtonText: 'Batal',
            customClass: {
                popup: 'rounded-4 shadow-lg border-0',
                confirmButton: 'btn btn-danger rounded-pill px-4',
                cancelButton: 'btn btn-light rounded-pill px-4 ms-2'
            },
            buttonsStyling: false
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('bulkDeleteForm').submit();
            }
        })
    }
</script>
