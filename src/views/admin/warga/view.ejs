<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom border-light">
    <h1 class="h2 fw-bold text-dark">Detail Warga: <span class="text-primary"><%= warga.nama_lengkap %></span></h1>
    <a href="/admin/warga" class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm fw-medium"><i class="bi bi-arrow-left me-1"></i> Kembali</a>
</div>

<div class="row g-4 mb-5">
    <% schema.sections.forEach((section, sIdx) => { %>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header border-bottom-0 pt-4 pb-3 px-4 bg-<%= ['primary', 'success', 'info', 'warning', 'secondary', 'dark'][sIdx % 6] %> bg-opacity-10">
                    <h5 class="card-title fw-bold mb-0 text-<%= ['primary', 'success', 'info', 'warning', 'secondary', 'dark'][sIdx % 6] %>">
                        <i class="bi bi-journal-text me-2"></i> <%= section.title %>
                    </h5>
                </div>
                <div class="card-body p-4">
                    <ul class="list-group list-group-flush">
                        <% section.fields.forEach(field => { %>
                            <li class="list-group-item px-0 py-3 border-light d-flex flex-column flex-sm-row justify-content-between align-items-sm-center">
                                <span class="text-secondary small fw-medium mb-1 mb-sm-0"><%= field.label %></span>
                                <span class="fw-semibold text-dark text-sm-end">
                                    <% if (field.name === 'dusun') { %>
                                        <%= warga.Dusun ? warga.Dusun.nama_dusun : '-' %>
                                    <% } else if (field.type === 'checkbox_group') { %>
                                        <%= Array.isArray(warga[field.name]) && warga[field.name].length > 0 ? warga[field.name].join(', ') : '-' %>
                                    <% } else if (field.type === 'radio' || field.type === 'select') { %>
                                        <% 
                                            const opt = (field.options || []).find(o => o.value == warga[field.name]);
                                            const displayValue = opt ? opt.label : warga[field.name];
                                        %>
                                        <%= (displayValue !== null && displayValue !== undefined && displayValue !== '') ? displayValue : '-' %>
                                    <% } else { %>
                                        <%= (warga[field.name] !== null && warga[field.name] !== undefined && warga[field.name] !== '') ? warga[field.name] : '-' %>
                                    <% } %>
                                </span>
                            </li>
                        <% }) %>
                    </ul>
                </div>
            </div>
        </div>
    <% }) %>
</div>

<div class="card border-0 rounded-4 shadow-sm bg-info bg-opacity-10 mb-5">
    <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center">
        <div class="mb-3 mb-md-0 d-flex align-items-center">
            <div class="avatar bg-info text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px;">
                <i class="bi bi-person-badge fs-4"></i>
            </div>
            <div>
                <span class="text-info small d-block fw-medium">Diinput Oleh</span>
                <span class="fw-bold text-dark fs-5"><%= warga.creator ? warga.creator.nama_lengkap : 'Admin' %></span>
            </div>
        </div>
        <div class="text-md-end border-start border-info border-opacity-25 ps-md-4">
            <span class="text-info small d-block fw-medium mb-1"><i class="bi bi-clock-history me-1"></i> Waktu Pencatatan</span>
            <span class="fw-semibold text-dark"><%= new Date(warga.created_at).toLocaleString() %></span>
        </div>
    </div>
</div>
