<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Laporan & Statistik Kependudukan</h1>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <!-- 1. Laporan Demografi -->
    <div class="col">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3">
                        <i class="bi bi-people-fill text-primary fs-3"></i>
                    </div>
                    <h5 class="card-title mb-0">Demografi & Kependudukan</h5>
                </div>
                <p class="card-text text-secondary small">Profil dasar warga: umur, jenis kelamin, agama, pendidikan, dan sebaran per Dusun.</p>
                <a href="/admin/reports/demografi" class="btn btn-outline-primary btn-sm w-100">Buka Laporan</a>
            </div>
        </div>
    </div>

    <!-- 2. Laporan Sanitasi -->
    <div class="col">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success bg-opacity-10 p-3 rounded-3 me-3">
                        <i class="bi bi-droplet-fill text-success fs-3"></i>
                    </div>
                    <h5 class="card-title mb-0">Sanitasi & Lingkungan</h5>
                </div>
                <p class="card-text text-secondary small">Akses air bersih, fasilitas BAB (MCK), dan sistem pengelolaan sampah rumah tangga.</p>
                <a href="/admin/reports/sanitasi" class="btn btn-outline-success btn-sm w-100">Buka Laporan</a>
            </div>
        </div>
    </div>

    <!-- 3. Laporan Kesehatan -->
    <div class="col">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-danger bg-opacity-10 p-3 rounded-3 me-3">
                        <i class="bi bi-heart-pulse-fill text-danger fs-3"></i>
                    </div>
                    <h5 class="card-title mb-0">Profil Kesehatan Terpadu</h5>
                </div>
                <p class="card-text text-secondary small">Jaminan kesehatan (BPJS), penyakit kronis, disabilitas, dan akseptor KB.</p>
                <a href="/admin/reports/kesehatan" class="btn btn-outline-danger btn-sm w-100">Buka Laporan</a>
            </div>
        </div>
    </div>

    <!-- 4. Laporan Kesejahteraan -->
    <div class="col">
        <div class="card h-100 border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-3 me-3">
                        <i class="bi bi-house-check-fill text-warning fs-3"></i>
                    </div>
                    <h5 class="card-title mb-0">Kesejahteraan & Hunian</h5>
                </div>
                <p class="card-text text-secondary small">Kelayakan rumah, akses energi (listrik/gas), dan inventarisasi aset kendaraan/elektronik.</p>
                <a href="/admin/reports/kesejahteraan" class="btn btn-outline-warning btn-sm w-100">Buka Laporan</a>
            </div>
        </div>
    </div>

    <!-- 5. Master Data -->
    <div class="col">
        <div class="card h-100 border-0 shadow-sm bg-light">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success bg-opacity-10 p-3 rounded-3 me-3">
                        <i class="bi bi-file-earmark-excel-fill text-success fs-3"></i>
                    </div>
                    <h5 class="card-title mb-0">Master Data (Excel)</h5>
                </div>
                <p class="card-text text-secondary small">Unduh seluruh data mentah warga dalam format Excel (.xlsx) untuk diolah secara mandiri.</p>
                <a href="/admin/reports/export-csv" class="btn btn-success btn-sm w-100">Unduh Excel</a>
            </div>
        </div>
    </div>
</div>
