<nav aria-label="breadcrumb" class="no-print">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/admin/reports">Laporan</a></li>
    <li class="breadcrumb-item active" aria-current="page">Kesehatan</li>
  </ol>
</nav>

<div class="d-none d-print-block text-center mb-4">
    <h4 class="mb-0 fw-bold">PEMERINTAH KABUPATEN GORONTALO</h4>
    <h4 class="mb-0 fw-bold">KECAMATAN BONGOMEME</h4>
    <h4 class="mb-0 fw-bold">DESA MOLANIHU</h4>
    <hr style="border-top: 3px solid black; opacity: 1; margin-bottom: 2px; margin-top: 15px;">
    <hr style="border-top: 1px solid black; opacity: 1; margin-top: 0; margin-bottom: 20px;">
</div>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h2 fw-bold mb-0">Laporan Profil Kesehatan Terpadu</h1>
        <p class="text-secondary mb-0">Pemetaan asuransi, penyakit kronis, dan kesehatan ibu/anak.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 no-print">
        <button type="button" class="btn btn-primary shadow-sm" onclick="window.print()">
            <i class="bi bi-printer-fill me-2"></i> Cetak Laporan
        </button>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Jaminan Kesehatan -->
    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold">Cakupan Jaminan Kesehatan (BPJS/Asuransi)</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <% stats.jaminan.forEach(item => { %>
                        <div class="col-md-3">
                            <div class="p-3 border rounded-3 h-100 bg-light-subtle d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 p-2 rounded me-3">
                                    <i class="bi bi-shield-check text-primary fs-4"></i>
                                </div>
                                <div>
                                    <div class="h4 fw-bold mb-0"><%= item.get('count') %></div>
                                    <div class="text-secondary text-uppercase fw-bold" style="font-size: 0.6rem;"><%= item.jaminan_kesehatan || 'Tidak Ada' %></div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>

    <!-- Penyakit Kronis & Disabilitas -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex align-items-center">
                <i class="bi bi-virus2 text-danger me-2 fs-4"></i>
                <h5 class="mb-0 fw-bold">Pemetaan Penyakit Kronis</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Jenis Penyakit</th>
                                <th class="text-end pe-4">Jumlah Kasus</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% Object.keys(penyakitCounts).forEach(p => { %>
                                <% if (p !== 'tidak_ada') { %>
                                    <tr>
                                        <td class="ps-4 text-capitalize fw-medium"><%= p %></td>
                                        <td class="text-end pe-4">
                                            <span class="badge bg-danger bg-opacity-10 text-danger fw-bold"><%= penyakitCounts[p] %></span>
                                        </td>
                                    </tr>
                                <% } %>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex align-items-center">
                <i class="bi bi-person-wheelchair text-warning me-2 fs-4"></i>
                <h5 class="mb-0 fw-bold">Status Disabilitas</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Jenis Disabilitas</th>
                                <th class="text-end pe-4">Jumlah</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% Object.keys(disabilitasCounts).forEach(d => { %>
                                <% if (d !== 'tidak_ada') { %>
                                    <tr>
                                        <td class="ps-4 text-capitalize fw-medium"><%= d %></td>
                                        <td class="text-end pe-4 fw-bold"><%= disabilitasCounts[d] %></td>
                                    </tr>
                                <% } %>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Akseptor KB -->
    <div class="col-md-12">
        <div class="card border-0 shadow-sm bg-gradient-info text-white" style="background: linear-gradient(45deg, #0dcaf0, #0aa2c0);">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-4">
                        <h5 class="fw-bold mb-1">Laporan Akseptor KB</h5>
                        <p class="text-white-50 small mb-0">Target: Perempuan Usia Produktif (18-49 thn)</p>
                    </div>
                    <div class="col-md-8">
                        <div class="row g-2">
                            <% stats.kb.forEach(item => { %>
                                <div class="col">
                                    <div class="bg-white bg-opacity-20 p-3 rounded text-center border border-white border-opacity-25">
                                        <div class="h3 fw-bold mb-0"><%= item.get('count') %></div>
                                        <div class="text-uppercase fw-bold" style="font-size: 0.65rem;"><%= item.jenis_kb || 'Belum KB' %></div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
