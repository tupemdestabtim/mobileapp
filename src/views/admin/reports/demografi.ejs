<nav aria-label="breadcrumb" class="no-print">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/admin/reports">Laporan</a></li>
    <li class="breadcrumb-item active" aria-current="page">Demografi</li>
  </ol>
</nav>

<div class="d-none d-print-block text-center mb-4">
    <h4 class="mb-0 fw-bold">PEMERINTAH KABUPATEN GORONTALO</h4>
    <h4 class="mb-0 fw-bold">KECAMATAN BONGOMEME</h4>
    <h4 class="mb-0 fw-bold">DESA MOLANIHU</h4>
    <hr style="border-top: 3px solid black; opacity: 1; margin-bottom: 2px; margin-top: 15px;">
    <hr style="border-top: 1px solid black; opacity: 1; margin-top: 0; margin-bottom: 20px;">
</div>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h2 fw-bold mb-0">Laporan Demografi & Kependudukan</h1>
        <p class="text-secondary mb-0">Ringkasan profil dasar kependudukan seluruh wilayah.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 no-print">
        <button type="button" class="btn btn-primary shadow-sm" onclick="window.print()">
            <i class="bi bi-printer-fill me-2"></i> Cetak Laporan
        </button>
    </div>
</div>

<!-- Statistik Ringkas -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50 text-uppercase fw-bold small mb-1">Total Penduduk</h6>
                        <h2 class="mb-0 fw-bold"><%= totalWarga %></h2>
                    </div>
                    <i class="bi bi-people-fill fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <% 
        let lCount = 0, pCount = 0;
        byGender.forEach(g => {
            if(g.jenis_kelamin === 'L') lCount = g.get('count');
            if(g.jenis_kelamin === 'P') pCount = g.get('count');
        });
        %>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h6 class="text-secondary text-uppercase fw-bold small mb-3">Rasio Jenis Kelamin</h6>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: <%= (lCount/totalWarga*100) %>%"></div>
                    <div class="progress-bar bg-danger" role="progressbar" style="width: <%= (pCount/totalWarga*100) %>%"></div>
                </div>
                <div class="d-flex justify-content-between mt-2 small">
                    <span><i class="bi bi-circle-fill text-info me-1"></i> L: <%= lCount %></span>
                    <span><i class="bi bi-circle-fill text-danger me-1"></i> P: <%= pCount %></span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <!-- Sebaran Dusun -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold text-dark">Sebaran Penduduk per Dusun</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Nama Dusun</th>
                                <th class="text-center">Jumlah Penduduk</th>
                                <th>Visualisasi</th>
                                <th class="text-end pe-4">Estimasi KK</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% byDusun.forEach(item => { 
                                let pct = (item.count / totalWarga * 100).toFixed(1);
                            %>
                                <tr>
                                    <td class="ps-4 fw-medium"><%= item.Dusun.nama_dusun || 'Tidak Diketahui' %></td>
                                    <td class="text-center"><span class="badge bg-light text-dark border"><%= item.count %></span></td>
                                    <td style="width: 30%;">
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-primary" style="width: <%= pct %>%"></div>
                                        </div>
                                        <small class="text-muted"><%= pct %>% dari total</small>
                                    </td>
                                    <td class="text-end pe-4 text-secondary">± <%= Math.ceil(item.count / 3.5) %> KK</td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pendidikan -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold text-dark">Profil Pendidikan Terakhir</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <% byPendidikan.forEach(item => { %>
                        <div class="col-md-4">
                            <div class="p-3 border rounded-3 h-100 bg-light-subtle">
                                <div class="text-secondary text-uppercase fw-bold" style="font-size: 0.65rem;"><%= item.pendidikan_terakhir || 'Lainnya' %></div>
                                <div class="d-flex align-items-baseline mt-1">
                                    <span class="h4 fw-bold mb-0"><%= item.get('count') %></span>
                                    <span class="ms-2 text-muted small">Warga</span>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <!-- Agama -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="mb-0 fw-bold text-dark">Komposisi Agama</h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <% byAgama.forEach(item => { %>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="text-capitalize"><%= item.agama || 'Tidak Diisi' %></span>
                            <span class="fw-bold"><%= item.get('count') %></span>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <!-- Info Tambahan / Legend -->
        <div class="card border-0 shadow-sm bg-light border-start border-primary border-4">
            <div class="card-body">
                <h6 class="fw-bold"><i class="bi bi-info-circle me-2"></i>Catatan Data</h6>
                <p class="small text-secondary mb-0">Data diperbarui secara real-time berdasarkan input dari petugas lapangan. Estimasi KK dihitung menggunakan rata-rata nasional (3.5 jiwa/KK).</p>
            </div>
        </div>
    </div>
</div>
