<nav aria-label="breadcrumb" class="no-print">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/admin/reports">Laporan</a></li>
    <li class="breadcrumb-item active" aria-current="page">Sanitasi</li>
  </ol>
</nav>

<div class="d-none d-print-block text-center mb-4">
    <h4 class="mb-0 fw-bold">PEMERINTAH KABUPATEN GORONTALO</h4>
    <h4 class="mb-0 fw-bold">KECAMATAN BONGOMEME</h4>
    <h4 class="mb-0 fw-bold">DESA MOLANIHU</h4>
    <hr style="border-top: 3px solid black; opacity: 1; margin-bottom: 2px; margin-top: 15px;">
    <hr style="border-top: 1px solid black; opacity: 1; margin-top: 0; margin-bottom: 20px;">
</div>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h2 fw-bold mb-0">Laporan Evaluasi Sanitasi & Lingkungan</h1>
        <p class="text-secondary mb-0">Pemetaan akses air bersih dan kualitas kesehatan lingkungan.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 no-print">
        <button type="button" class="btn btn-primary shadow-sm" onclick="window.print()">
            <i class="bi bi-printer-fill me-2"></i> Cetak Laporan
        </button>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Air Bersih Section -->
    <div class="col-md-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 py-3 d-flex align-items-center">
                <i class="bi bi-droplet-fill text-info me-2 fs-4"></i>
                <h5 class="mb-0 fw-bold">Akses & Sumber Air Minum</h5>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-12">
                        <label class="small text-secondary fw-bold text-uppercase mb-2">Sebaran Sumber Air</label>
                        <% stats.sumber_air_minum.forEach(item => { %>
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small fw-medium"><%= item.sumber_air_minum || 'Lainnya' %></span>
                                    <span class="small fw-bold"><%= item.get('count') %></span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-info" style="width: <%= (item.get('count') / (stats.sumber_air_minum.reduce((a, b) => a + b.get('count'), 0)) * 100) %>%"></div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100 bg-light-subtle">
            <div class="card-header bg-transparent border-0 py-3">
                <h6 class="mb-0 fw-bold">Indikator Kualitas Air</h6>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush bg-transparent">
                    <% stats.kualitas_air_minum.forEach(item => { %>
                        <% 
                            let colorClass = item.kualitas_air_minum === 'baik' ? 'text-success' : 'text-danger';
                            let icon = item.kualitas_air_minum === 'baik' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
                        %>
                        <div class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 py-3">
                            <div class="d-flex align-items-center">
                                <i class="bi <%= icon %> <%= colorClass %> me-3 fs-4"></i>
                                <div>
                                    <div class="fw-bold text-capitalize"><%= item.kualitas_air_minum %></div>
                                    <div class="small text-secondary">Kondisi Fisik Air</div>
                                </div>
                            </div>
                            <h4 class="mb-0 fw-bold"><%= item.get('count') %></h4>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Fasilitas Sanitasi -->
    <div class="col-md-12">
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="card-header bg-white border-0 py-3 border-bottom">
                <h5 class="mb-0 fw-bold">Laporan Fasilitas Sanitasi (MCK)</h5>
            </div>
            <div class="card-body p-0">
                <div class="row g-0">
                    <div class="col-md-4 border-end">
                        <div class="p-4">
                            <h6 class="text-secondary fw-bold text-uppercase small mb-4">Kepemilikan Jamban</h6>
                            <% stats.fasilitas_bab.forEach(item => { %>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-capitalize small"><%= item.fasilitas_bab %></span>
                                    <span class="badge rounded-pill bg-light text-dark border fw-bold"><%= item.get('count') %></span>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                    <div class="col-md-4 border-end">
                        <div class="p-4">
                            <h6 class="text-secondary fw-bold text-uppercase small mb-4">Jenis Kloset</h6>
                            <% stats.jenis_kloset.forEach(item => { %>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-capitalize small"><%= item.jenis_kloset %></span>
                                    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-10 fw-bold"><%= item.get('count') %></span>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-4">
                            <h6 class="text-secondary fw-bold text-uppercase small mb-4">Pembuangan Akhir</h6>
                            <% stats.pembuangan_akhir_tinja.forEach(item => { %>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-capitalize small"><%= item.pembuangan_akhir_tinja %></span>
                                    <span class="badge rounded-pill bg-dark bg-opacity-10 text-dark border border-dark border-opacity-10 fw-bold"><%= item.get('count') %></span>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sampah -->
    <div class="col-md-12 mb-4">
        <div class="card border-0 shadow-sm bg-success bg-opacity-10">
            <div class="card-body p-4">
                <h6 class="fw-bold text-success-emphasis mb-4">Indikator Kebersihan: Pengelolaan Sampah</h6>
                <div class="row g-3">
                    <% stats.pengelolaan_sampah.forEach(item => { %>
                        <div class="col">
                            <div class="bg-white p-3 rounded shadow-sm text-center h-100 border-bottom border-success border-4">
                                <div class="h3 fw-bold mb-1 text-success"><%= item.get('count') %></div>
                                <div class="text-secondary fw-bold" style="font-size: 0.65rem; line-height: 1.2;"><%= item.pengelolaan_sampah.toUpperCase() %></div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>
