<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom border-light">
    <h1 class="h2 fw-bold text-dark">Manajemen Keluarga (KK)</h1>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h5 class="card-title fw-bold text-dark mb-0"><i class="bi bi-houses-fill text-primary me-2"></i> Daftar Nomor KK</h5>
            <form action="/admin/keluarga" method="GET" class="input-group input-group-sm w-100" style="max-width: 300px;">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Cari No. KK..." value="<%= search %>">
            </form>
        </div>
    </div>
    <div class="card-body px-0 pt-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="kkTable">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="border-0 ps-4 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Nomor KK</th>
                        <th class="border-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Wilayah Dusun</th>
                        <th class="border-0 fw-medium text-uppercase small text-center d-none d-sm-table-cell" style="letter-spacing: 0.5px;">Total Anggota</th>
                        <th class="border-0 pe-4 fw-medium text-uppercase small text-end" style="letter-spacing: 0.5px;">Aksi</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    <% keluarga.forEach(k => { %>
                        <tr class="kk-row">
                            <td class="ps-4 py-3">
                                <span class="fw-bold text-dark font-monospace fs-6"><%= k.no_kk %></span>
                                <div class="d-sm-none small text-muted"><%= k.total_anggota %> Anggota</div>
                            </td>
                            <td class="py-3">
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1 rounded-pill">
                                    <i class="bi bi-geo-alt-fill me-1"></i><%= k.nama_dusun %>
                                </span>
                            </td>
                            <td class="py-3 text-center d-none d-sm-table-cell">
                                <span class="badge bg-primary rounded-pill px-3"><%= k.total_anggota %> Orang</span>
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <a href="/admin/keluarga/view/<%= k.no_kk %>" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    <i class="bi bi-eye"></i> <span class="d-none d-md-inline">Lihat</span>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (keluarga.length === 0) { %>
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                Belum ada data keluarga terdaftar.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <% if (totalPages > 1) { %>
        <div class="card-footer bg-white border-top-0 pb-4 px-4">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link rounded-pill px-3 me-2" href="?page=<%= currentPage - 1 %>&search=<%= search %>&limit=<%= limit %>" aria-label="Previous">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                            <a class="page-link rounded-circle mx-1" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;" href="?page=<%= i %>&search=<%= search %>&limit=<%= limit %>"><%= i %></a>
                        </li>
                    <% } %>
                    <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                        <a class="page-link rounded-pill px-3 ms-2" href="?page=<%= currentPage + 1 %>&search=<%= search %>&limit=<%= limit %>" aria-label="Next">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
            <div class="text-center text-muted small mt-3">
                Menampilkan <%= keluarga.length %> dari <%= totalItems %> keluarga
            </div>
        </div>
    <% } %>
</div>

<script>
    // Server-side search implemented.
</script>
