<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom border-light">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item small"><a href="/admin/keluarga" class="text-decoration-none">Data Keluarga</a></li>
                <li class="breadcrumb-item small active" aria-current="page">Detail</li>
            </ol>
        </nav>
        <h1 class="h2 fw-bold text-dark">Keluarga No: <span class="text-primary"><%= no_kk %></span></h1>
    </div>
    <a href="/admin/keluarga" class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm fw-medium"><i class="bi bi-arrow-left me-1"></i> Kembali</a>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4">
        <h5 class="card-title fw-bold text-dark mb-0"><i class="bi bi-people-fill text-primary me-2"></i> Anggota Keluarga</h5>
    </div>
    <div class="card-body px-0 pt-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th class="border-0 ps-4 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">NIK</th>
                        <th class="border-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Nama Lengkap</th>
                        <th class="border-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Hubungan</th>
                        <th class="border-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Jenis Kelamin</th>
                        <th class="border-0 fw-medium text-uppercase small" style="letter-spacing: 0.5px;">Umur</th>
                        <th class="border-0 pe-4 fw-medium text-uppercase small text-end" style="letter-spacing: 0.5px;">Aksi</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    <% anggota.forEach(w => { %>
                        <tr>
                            <td class="ps-4 py-3"><span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1 rounded-pill font-monospace"><%= w.nik %></span></td>
                            <td class="py-3">
                                <div class="fw-semibold text-dark"><%= w.nama_lengkap %></div>
                                <div class="text-muted small"><%= w.Dusun ? w.Dusun.nama_dusun : '-' %></div>
                            </td>
                            <td class="py-3">
                                <% 
                                    const hubField = schema.sections.flatMap(s => s.fields).find(f => f.name === 'hubungan_keluarga');
                                    const hubOpt = hubField ? hubField.options.find(o => o.value == w.hubungan_keluarga) : null;
                                    const hubLabel = hubOpt ? hubOpt.label : (w.hubungan_keluarga || '-');
                                %>
                                <span class="badge <%= hubLabel.toLowerCase() === 'kepala keluarga' ? 'bg-primary' : 'bg-light text-dark border' %> px-2 py-1 rounded-pill">
                                    <%= hubLabel %>
                                </span>
                            </td>
                            <td class="py-3">
                                <span class="text-secondary"><%= w.jenis_kelamin || '-' %></span>
                            </td>
                            <td class="py-3">
                                <span class="text-secondary"><%= w.umur || '-' %> Thn</span>
                            </td>
                            <td class="pe-4 py-3 text-end">
                                <div class="btn-group shadow-sm rounded-pill" role="group">
                                    <a href="/admin/warga/view/<%= w.id %>" class="btn btn-light btn-sm text-primary border border-end-0 px-3" title="Detail"><i class="bi bi-eye"></i></a>
                                    <a href="/admin/warga/edit/<%= w.id %>" class="btn btn-light btn-sm text-warning border px-3" title="Edit"><i class="bi bi-pencil-square"></i></a>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle text-primary me-2"></i> Informasi KK</h6>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary small">Total Anggota:</span>
                    <span class="fw-bold text-dark"><%= anggota.length %> Orang</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary small">Wilayah (Dusun):</span>
                    <span class="fw-bold text-dark"><%= anggota[0].Dusun ? anggota[0].Dusun.nama_dusun : '-' %></span>
                </div>
            </div>
        </div>
    </div>
</div>
