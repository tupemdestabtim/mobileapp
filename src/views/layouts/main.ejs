<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noodp, noydir">
    <title>Pendataan Penduduk 2026</title>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --sidebar-width: 260px;
            --navbar-height: 64px;
        }
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #f1f5f9; /* Slate 100 */
            color: #1e293b; /* Slate 800 */
            min-height: 100vh;
            margin: 0;
            overflow-x: hidden;
        }
        /* Navbar */
        .top-navbar {
            background-color: #ffffff;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            z-index: 1050;
            height: var(--navbar-height);
            position: fixed;
            top: 0;
            right: 0;
            left: 0;
            padding: 0;
        }
        /* Sidebar Modern */
        .sidebar { 
            height: 100vh;
            background-color: #0f172a; /* Slate 900 */
            color: #e2e8f0;
            box-shadow: 4px 0 24px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1040;
            width: var(--sidebar-width);
            display: flex;
            flex-direction: column;
        }
        .sidebar-brand {
            height: var(--navbar-height);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .sidebar .nav-link { 
            color: #94a3b8; 
            font-weight: 500;
            padding: 0.8rem 1.25rem; 
            border-radius: 0.75rem;
            margin: 0.2rem 1rem;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
        }
        .sidebar .nav-link:hover { 
            color: #ffffff; 
            background-color: rgba(255,255,255,0.05); 
        }
        .sidebar .nav-link.active { 
            color: #ffffff; 
            background-color: #3b82f6; /* Blue 500 */
            box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3);
        }
        .sidebar .nav-link i {
            font-size: 1.25rem;
            margin-right: 0.75rem;
        }
        .main-content { 
            padding: 1.5rem;
            transition: all 0.3s ease;
            margin-top: var(--navbar-height);
            width: 100%;
        }
        
        @media (min-width: 768px) {
            .main-content {
                padding: 2.5rem;
                margin-left: var(--sidebar-width);
                width: calc(100% - var(--sidebar-width));
            }
            .top-navbar {
                left: var(--sidebar-width);
            }
        }

        @media (max-width: 767.98px) {
            .sidebar {
                transform: translateX(-100%);
                width: 280px;
            }
            .sidebar.show {
                transform: translateX(0);
            }
            .main-content {
                padding: 1.25rem;
                margin-left: 0;
                width: 100%;
            }
            .sidebar-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 1035;
                backdrop-filter: blur(2px);
            }
            .sidebar-overlay.show {
                display: block;
            }
        }

        /* Card styling global */
        .card {
            border: none;
            border-radius: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        }

        /* Custom Scrollbar for Sidebar */
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }

        @media print {
            .sidebar, .top-navbar, .sidebar-overlay, .no-print, .btn { display: none !important; }
            .main-content { margin: 0 !important; padding: 0 !important; width: 100% !important; }
            body { background-color: #fff !important; }
        }
    </style>
</head>
<body>
    <% if (user && user.role === 'admin') { %>
    <!-- Sidebar Overlay (Mobile Only) -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Sidebar -->
    <nav id="sidebarMenu" class="sidebar">
        <div class="sidebar-brand">
            <a class="text-white text-decoration-none fw-bold d-flex align-items-center" href="/admin/dashboard">
                <i class="bi bi-hexagon-fill text-primary me-2 fs-4"></i> <span>MOLANIHU</span>
            </a>
            <button type="button" class="btn-close btn-close-white ms-auto d-md-none" id="sidebarClose"></button>
        </div>

        <div class="flex-grow-1 overflow-auto custom-scrollbar pt-4">
            <div class="px-4 mb-2 text-uppercase fw-bold text-secondary opacity-50" style="font-size: 0.7rem; letter-spacing: 1.5px;">Main Menu</div>
            <ul class="nav flex-column mb-4">
                <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i class="bi bi-grid-1x2-fill"></i> Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/dusun"><i class="bi bi-geo-alt-fill"></i> Data Dusun</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/warga"><i class="bi bi-person-vcard-fill"></i> Data Warga</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/keluarga"><i class="bi bi-houses-fill"></i> Data Keluarga</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/reports"><i class="bi bi-file-earmark-bar-graph-fill"></i> Laporan</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/users"><i class="bi bi-people-fill"></i> Petugas</a></li>
            </ul>

            <div class="px-4 mb-2 text-uppercase fw-bold text-secondary opacity-50" style="font-size: 0.7rem; letter-spacing: 1.5px;">Security & System</div>
            <ul class="nav flex-column mb-auto">
                <li class="nav-item"><a class="nav-link" href="/admin/monitoring"><i class="bi bi-shield-check"></i> Security Monitor</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/audit"><i class="bi bi-clock-history"></i> Log Aktivitas</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/settings"><i class="bi bi-sliders"></i> Pengaturan</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/system"><i class="bi bi-database-fill-gear"></i> Sinkronisasi</a></li>
                <li class="nav-item"><a class="nav-link" href="/admin/app-logs"><i class="bi bi-bug"></i> App Logs</a></li>
            </ul>
        </div>
        
        <div class="p-3 border-top border-secondary border-opacity-10 d-md-none">
            <a href="javascript:void(0)" onclick="confirmLogout()" class="btn btn-outline-danger w-100 rounded-pill py-2 small fw-bold">LOGOUT</a>
        </div>
    </nav>

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg top-navbar">
        <div class="container-fluid px-3 px-lg-4">
            <div class="d-flex align-items-center">
                <button class="btn btn-link text-dark d-md-none me-2 p-0" type="button" id="sidebarToggle">
                    <i class="bi bi-list fs-2"></i>
                </button>
                <div class="d-none d-md-block">
                    <h5 class="mb-0 fw-bold text-dark">Panel Administrator</h5>
                </div>
            </div>
            
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center link-dark text-decoration-none dropdown-toggle" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="text-end me-2 d-none d-sm-block">
                        <div class="fw-bold small line-height-1 text-dark text-capitalize"><%= user.nama_lengkap || user.username %></div>
                        <div class="text-muted small" style="font-size: 0.7rem;">Admin Online</div>
                    </div>
                    <img src="https://ui-avatars.com/api/?name=<%= user.username %>&background=3b82f6&color=fff&bold=true" alt="user" width="38" height="38" class="rounded-circle border border-2 border-white shadow-sm">
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" aria-labelledby="dropdownUser" style="border-radius: 1rem;">
                    <li><a class="dropdown-item py-2" href="/admin/settings"><i class="bi bi-gear me-2"></i> Settings</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item py-2 text-danger" href="javascript:void(0)" onclick="confirmLogout()"><i class="bi bi-box-arrow-right me-2"></i> Sign out</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="main-content">
        <%- body %>
    </main>

    <% } else { %>
    <main>
        <%- body %>
    </main>
    <% } %>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // SweetAlert for Global Notifications
            <% if (success_msg) { %>
                Swal.fire({
                    icon: 'success',
                    title: 'Berhasil!',
                    text: '<%= success_msg %>',
                    timer: 3000,
                    showConfirmButton: false,
                    customClass: { popup: 'rounded-4 shadow-lg border-0' }
                });
            <% } %>
            
            <% if (error_msg) { %>
                Swal.fire({
                    icon: 'error',
                    title: 'Gagal!',
                    text: '<%= error_msg %>',
                    customClass: { popup: 'rounded-4 shadow-lg border-0' }
                });
            <% } %>

            // Active link handling
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.sidebar .nav-link');
            navLinks.forEach(link => {
                const href = link.getAttribute('href');
                if(currentPath === href || (currentPath.startsWith(href) && href !== '/admin/dashboard')) {
                    link.classList.add('active');
                }
            });

            // Form Submit Interceptor for Confirmation
            const forms = document.querySelectorAll('form');
            forms.forEach(form => {
                // Ignore search forms (GET), delete forms, or clear logs forms
                if (form.method.toUpperCase() === 'GET' || form.id.includes('delete') || form.id.includes('clearLogs')) return;
                
                // Specifically target Add/Edit forms for Warga, Dusun, Petugas, and Settings
                const action = form.getAttribute('action') || '';
                if (action.includes('/admin/warga') || 
                    action.includes('/admin/dusun') || 
                    action.includes('/admin/users') || 
                    action.includes('/admin/settings')) {
                    
                    form.addEventListener('submit', function(e) {
                        if (!form.checkValidity()) return; // Let HTML5 validation run first
                        if (form.dataset.confirmed === 'true') return; // Allow submission if already confirmed

                        e.preventDefault();

                        let title = 'Simpan Data?';
                        let text = 'Pastikan data yang Anda masukkan sudah benar.';
                        let confirmBtn = 'Ya, Simpan!';
                        let btnColor = '#3b82f6'; // primary

                        // Adjust wording for updates/edits
                        if (action.includes('edit') || action.includes('update') || action.includes('settings')) {
                            title = 'Simpan Perubahan?';
                            text = 'Perubahan data akan disimpan ke sistem.';
                            confirmBtn = 'Ya, Update!';
                            btnColor = '#f59e0b'; // warning
                        }

                        Swal.fire({
                            title: title,
                            text: text,
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonColor: btnColor,
                            cancelButtonColor: '#64748b',
                            confirmButtonText: confirmBtn,
                            cancelButtonText: 'Batal',
                            customClass: {
                                popup: 'rounded-4 shadow-lg border-0',
                                confirmButton: `btn ${btnColor === '#3b82f6' ? 'btn-primary' : 'btn-warning text-dark'} rounded-pill px-4 fw-bold`,
                                cancelButton: 'btn btn-light rounded-pill px-4 ms-2 fw-bold'
                            },
                            buttonsStyling: false
                        }).then((result) => {
                            if (result.isConfirmed) {
                                form.dataset.confirmed = 'true';
                                // Add loading spinner to submit button
                                const btn = form.querySelector('button[type="submit"]');
                                if (btn) {
                                    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Memproses...';
                                    btn.disabled = true;
                                }
                                form.submit();
                            }
                        });
                    });
                }
            });

            // Sidebar toggle logic
            const sidebar = document.getElementById('sidebarMenu');
            const overlay = document.getElementById('sidebarOverlay');
            const toggle = document.getElementById('sidebarToggle');
            const close = document.getElementById('sidebarClose');

            function toggleSidebar() {
                if (sidebar) sidebar.classList.toggle('show');
                if (overlay) overlay.classList.toggle('show');
            }

            if(toggle) toggle.addEventListener('click', toggleSidebar);
            if(close) close.addEventListener('click', toggleSidebar);
            if(overlay) overlay.addEventListener('click', toggleSidebar);
        });

        function confirmLogout() {
            Swal.fire({
                title: 'Keluar dari Sistem?',
                text: "Anda akan mengakhiri sesi administrasi ini.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Ya, Keluar',
                cancelButtonText: 'Batal',
                customClass: {
                    popup: 'rounded-4 shadow-lg border-0',
                    confirmButton: 'btn btn-danger rounded-pill px-4 fw-bold',
                    cancelButton: 'btn btn-light rounded-pill px-4 ms-2 fw-bold'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/admin/logout';
                }
            })
        }
    </script>
</body>
</html>